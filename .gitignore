# ==============================================================================
# ParkSmart .gitignore
# Polyglot Stack: Node.js, Python, C++17, React, Docker
# ==============================================================================

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Environment Variables & Secrets (Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/

# C++ Build Artifacts & Compiled Executables
*.exe
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.pdb
*.ilk
*.idb
services/service-3-slot-engine/slot_engine.exe
services/service-3-slot-engine/slot_engine

# Frontend Build Output
frontend/build/
frontend/dist/

# Logs & Temporary Files
*.log
logs/

# IDE & Editor Specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

docs/