# ==============================================================================
# ParkSmart - Environment Configuration Template
# ==============================================================================
# Note: When running via Docker Compose (`docker compose up --build`), these
# variables are automatically injected by `docker-compose.yml`.
# This file is only needed if you are running services individually on host.
# Copy this file to `.env` if custom overrides are needed.

# --- Global / Gateway (Port 5000) ---
PORT=5000
SERVICE_AUTH_URL=http://localhost:5001
SERVICE_AI_URL=http://localhost:5002
SERVICE_SLOT_URL=http://localhost:5003
SERVICE_RESERVATION_URL=http://localhost:5004
SERVICE_ANALYTICS_URL=http://localhost:5005

# --- Shared Infrastructure ---
RABBITMQ_URL=amqp://localhost:5672
JWT_SECRET=parksmart_distributed_secret_key_2026

# --- Service 1: Auth & User Management (Port 5001) ---
SERVICE_1_PORT=5001
AUTH_MONGODB_URI=mongodb://localhost:27017/parksmart_auth_db

# --- Service 2: AI ANPR & License OCR (Port 5002) ---
SERVICE_2_PORT=5002
AI_MONGODB_URI=mongodb://localhost:27017/parksmart_ai_db

# --- Service 3: C++ Slot Allocation Engine (Port 5003) ---
SERVICE_3_PORT=5003

# --- Service 4: Reservation & Booking Engine (Port 5004) ---
SERVICE_4_PORT=5004
BOOKING_MONGODB_URI=mongodb://localhost:27017/parksmart_booking_db

# --- Service 5: Dynamic Pricing & Predictive Analytics (Port 5005) ---
SERVICE_5_PORT=5005
ANALYTICS_MONGODB_URI=mongodb://localhost:27017/parksmart_analytics_db

# --- Frontend (Port 3000) ---
REACT_APP_API_URL=http://localhost:5000/api
